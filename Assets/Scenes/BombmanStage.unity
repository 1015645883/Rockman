  m_Name: 
  m_EditorClassIdentifier: 
  playerSpawnPoint: {fileID: 525641920}
  gutsmanSpawnPoint: {fileID: 360443569}
  player: {fileID: 0}
  gutsmanMelee: {fileID: 0}
  boss: {fileID: 1329876065}
  bossDoor: {fileID: 1186135264}
  bossHealthContainer: {fileID: 1859983948}
  mainCamera: {fileID: 0}
  bossCamera: {fileID: 1792339299}
  bgmSource: {fileID: 866499698}
  bossBgm: {fileID: 8300000, guid: fe523e247d8242e48a2f87ec799c4af1, type: 3}
  dialogueManager: {fileID: 183149740}
  dialoguePanel: {fileID: 492837706}
  dialogues:
  - playerName: Rockman
    playerKey: Rockman
    dialogueLines:
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u54CE\u54CE\u54CE\uFF01\u4E0D\u60F3\u88AB\u70B8\u7684\u8BDD\u5C31\u8D76\u5FEB\u7ED9\u6211\u6EDA\uFF0C\u6DF7\u86CB\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 94fdd6964a14e9b4e8f8992bcb39e176, type: 3}
    - speakerName: "\u6D1B\u514B\u4EBA"
      text: "\u592A\u5371\u9669\u4E86\uFF0C\u70B8\u5F39\u4EBA\uFF01\u522B\u518D\u8BA9\u70B8\u5F39\u7206\u70B8\u4E86\uFF01"
      speakerPortrait: {fileID: -1505411928, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 45902f5afe90f5840a8d6bb928f0a58d, type: 3}
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u5C11\u5570\u55E6\uFF0C\u6DF7\u8D26\u4E1C\u897F\uFF01\u8001\u5B50\u53EF\u4E0D\u4F1A\u7559\u7740\u8FC7\u591C\u7684\u70B8\u5F39\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: aad7907f116716346bef7593bad93be3, type: 3}
  - playerName: Blues
    playerKey: Blues
    dialogueLines:
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u54DF\uFF0C\u6F47\u6D12\u7684\u5927\u54E5\u5440\uFF01\u8981\u5F00\u5E72\u5417\uFF1F"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 3c586d75a6d7f4d4187c5157f755e345, type: 3}
    - speakerName: "\u5E03\u9C81\u65AF"
      text: "...\u6765\u5427\uFF0C\u73B0\u5728\u7684\u4F60\u592A\u5371\u9669\u4E86\uFF01"
      speakerPortrait: {fileID: 1110756348, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 262cd61da3951cd4da171861177c524f, type: 3}
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u597D\u6781\u4E86\uFF01\u4E0D\u7BA1\u662F\u6253\u67B6\u8FD8\u662F\u653E\u70DF\u82B1\uFF0C\u8001\u5B50\u4E00\u70B9\u90FD\u4E0D\u5E26\u6015\u7684\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 6a79cd6df4b48fb4c9908c9706cceed9, type: 3}
  - playerName: Cutman
    playerKey: Cutman
    dialogueLines:
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u54CE\u54CE\u54CE\uFF01\u4E0D\u60F3\u88AB\u70B8\u7684\u8BDD\u5C31\u8D76\u5FEB\u7ED9\u6211\u6EDA\uFF0C\u6DF7\u86CB\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 94fdd6964a14e9b4e8f8992bcb39e176, type: 3}
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u4F60\u4E0D\u4F1A\u8981\u628A\u90A3\u9897\u70B8\u5F39\u6254\u8FC7\u6765...\u5427\uFF1F..."
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 6e6b2f7a1366219449612fa1f2fe0b54, type: 3}
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u5C11\u5570\u55E6\uFF0C\u6DF7\u8D26\u4E1C\u897F\uFF01\u8001\u5B50\u53EF\u4E0D\u4F1A\u7559\u7740\u8FC7\u591C\u7684\u70B8\u5F39\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: aad7907f116716346bef7593bad93be3, type: 3}
  - playerName: Gutsman
    playerKey: Gutsman
    dialogueLines:
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u56AF\uFF01\u8FD9\u4E0D\u662F\u5DE5\u5934\u561B\uFF01\u8FD8\u662F\u4E00\u5982\u65E2\u5F80\u7684\u6709\u6C14\u52BF\u5462\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 21436bdac05c37949a779a4af5a832f2, type: 3}
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u5728\u8FD9\u79CD\u5730\u65B9\u54EA\u80FD\u4E71\u70B8\uFF1F\u8D76\u5FEB\u8DDF\u6211\u56DE\u5DE5\u5730\u53BB\uFF0C\u70B8\u5F39\u4EBA"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 4410d81b1fec7c548bf7bad49f4d7e20, type: 3}
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u54CE\u5440\uFF0C\u73B0\u5728\u5C31\u8981\u5F00\u5DE5\u54AF\u3002\u8BA9\u6211\u5728\u4F60\u90A3\u5927\u5757\u5934\u4E0A\u597D\u597D\u70B8\u4E00\u70B8\u5427\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 0b73e50271249be4f9d9c33bbaaaa006, type: 3}
  - playerName: Iceman
    playerKey: Iceman
    dialogueLines:
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u54CE\u54CE\u54CE\uFF01\u4E0D\u60F3\u88AB\u70B8\u7684\u8BDD\u5C31\u8D76\u5FEB\u7ED9\u6211\u6EDA\uFF0C\u6DF7\u86CB\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 94fdd6964a14e9b4e8f8992bcb39e176, type: 3}
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u54C7\u554A\u554A\uFF0C\u8BF7\u60A8\u4E0D\u8981\u505A\u8FD9\u79CD\u4E8B\u5440\uFF01"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: d8221cdf873573940b3c312af57ca426, type: 3}
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u5C11\u5570\u55E6\uFF0C\u6DF7\u8D26\u4E1C\u897F\uFF01\u8001\u5B50\u53EF\u4E0D\u4F1A\u7559\u7740\u8FC7\u591C\u7684\u70B8\u5F39\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: aad7907f116716346bef7593bad93be3, type: 3}
  - playerName: Bombman
    playerKey: Bombman
    dialogueLines:
    - speakerName: "\u70B8\u5F39\u4EBA\uFF1F"
      text: "\u54DF\uFF0C\u539F\u578B\uFF01\u53EA\u662F\u4E22\u70B8\u5F39\u8FD9\u79CD\u4E8B\u7684\u8BDD\uFF0C\u4E0D\u7BA1\u662F\u8C01\u90FD\u80FD\u505A\u5230\u5427\uFF1F"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: c550b808a56c5fe4386bbac54905fdc3, type: 3}
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u4F60\u8FD9\u4E2A\u6DF7\u86CB\uFF01\u62FF\u547D\u53BB\u70B9\u706B\u53EF\u662F\u53EA\u6709\u8001\u5B50\u8FD9\u79CD\u8001\u624B\u80FD\u5E72\u7684\u7EDD\u6D3B\u513F\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 69d9f73f05877fd48b8e3bbfba988182, type: 3}
    - speakerName: "\u70B8\u5F39\u4EBA\uFF1F"
      text: "\u8001\u5B50\u4E5F\u80FD\u529E\u5230\u54E6\uFF1F\u8981\u4E0D\u8BD5\u8BD5\u770B\uFF1F"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: a804f8a25c21b594f8c3072ff365a235, type: 3}
  - playerName: Fireman
    playerKey: Fireman
    dialogueLines:
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u54DF\uFF0C\u6F47\u6D12\u7684\u5927\u54E5\uFF01\u51C6\u5907\u4E86\u4E00\u5806\u70B8\u5F39\u6B63\u7B49\u7740\u4F60\u5462\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 64e15e9e3e812ee479f122f311f2366e, type: 3}
    - speakerName: "\u706B\u7130\u4EBA"
      text: "\u6211\u4F1A\u4E00\u4E2A\u4E0D\u7559\u5730\u5168\u90E8\u70E7\u5149\uFF01\u4EE5\u6211\u70BD\u70ED\u7684\u6B63\u4E49\u4E4B\u708E\uFF01\u71C3\u70E7\u5427\uFF01"
      speakerPortrait: {fileID: 104266460, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: b8da7a5bb5f3ff84a9e08761499cff7a, type: 3}
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u597D\u6781\u4E86\uFF01\u6211\u53EF\u6709\u5F97\u662F\u70B8\u5F39\uFF0C\u770B\u770B\u4F60\u80FD\u6491\u5230\u4EC0\u4E48\u65F6\u5019\u5427\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 4f5e3f25658b77148bf8e2f94c4cb7cd, type: 3}
  - playerName: Elecman
    playerKey: Elecman
    dialogueLines:
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u54CE\u54CE\u54CE\uFF01\u4E0D\u60F3\u88AB\u70B8\u7684\u8BDD\u5C31\u8D76\u5FEB\u7ED9\u6211\u6EDA\uFF0C\u6DF7\u86CB\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 94fdd6964a14e9b4e8f8992bcb39e176, type: 3}
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u54FC\u2026\u5C31\u9760\u90A3\u79CD\u6162\u541E\u541E\u7684\u653B\u51FB\u60F3\u548C\u6211\u7684\u7535\u51FB\u5BF9\u6297\uFF1F\u8FD8\u6CA1\u6765\u5F97\u53CA\u51FA\u624B\u51E0\u6B21\uFF0C\u9A6C\u4E0A\u5C31\u4F1A\u7ED3\u675F\u7684\u2026"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 3f47e79a23b6a344faa503191620d752, type: 3}
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u5C11\u5570\u55E6\uFF0C\u6DF7\u8D26\u4E1C\u897F\uFF01\u8001\u5B50\u53EF\u4E0D\u4F1A\u7559\u7740\u8FC7\u591C\u7684\u70B8\u5F39\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: aad7907f116716346bef7593bad93be3, type: 3}
  fillHealthSfx: {fileID: 8300000, guid: ca146d40119cf9443966cf3a809e6558, type: 3}
