--- !u!114 &723494568
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 723494566}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc8dbd3ceff49e04c90252d7d455d391, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  playerSpawnPoint: {fileID: 317089409}
  gutsmanSpawnPoint: {fileID: 346324745}
  player: {fileID: 0}
  gutsmanMelee: {fileID: 0}
  boss: {fileID: 4872820592680747314}
  bossDoor: {fileID: 131396248}
  bossHealthContainer: {fileID: 1326930384}
  mainCamera: {fileID: 0}
  bossCamera: {fileID: 884625591}
  bgmSource: {fileID: 1272904289}
  bossBgm: {fileID: 8300000, guid: fe523e247d8242e48a2f87ec799c4af1, type: 3}
  dialogueManager: {fileID: 723494571}
  dialoguePanel: {fileID: 85878155}
  dialogues:
  - playerName: Rockman
    playerKey: Rockman
    dialogueLines:
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u8001..\u8001\u54E5...\u5A01\u5229\u535A\u58EB\u8BF4\u7684\u90FD\u662F\u771F\u7684\u5417?..."
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: e29848ac70cf608408aae06b9887c214, type: 3}
    - speakerName: "\u6D1B\u514B\u4EBA"
      text: "\u526A\u5200\u4EBA...\u5230\u5E95\u53D1\u751F\u4EC0\u4E48\u4E86?"
      speakerPortrait: {fileID: -1505411928, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 3943ca3bfc34e4f4c9938a368912c7f5, type: 3}
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u201D\u8001\u54E5\u88AB\u6539\u9020\u6210\u4E86\u90AA\u6076\u7684\u6218\u6597\u673A\u5668\u4EBA,\u5728\u8FD9\u5468\u56F4\u5230\u5904\u641E\u7834\u574F...\u201C\u6211\u8981\u963B\u6B62\u8001\u54E5,\u8BA9\u4F60\u6062\u590D\u6B63\u5E38\uFF01"
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: d17b7eea4b7fd064389f348ebde58156, type: 3}
  - playerName: Blues
    playerKey: Blues
    dialogueLines:
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u54E6\u563F\uFF01\uFF1F\u4F60\u662F\u8C01\uFF1F\u4F60\u662F\u5A01\u5229\u535A\u58EB\u8BF4\u7684\u201C\u574F\u86CB\u673A\u5668\u4EBA\u201D\u5417\uFF1F"
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 934cf9117ea08a84586a82ba812a21ac, type: 3}
    - speakerName: "\u5E03\u9C81\u65AF"
      text: "\u526A\u5200\u4EBA...\u5FEB\u505C\u6B62\u4F5C\u6076\u5427"
      speakerPortrait: {fileID: 1110756348, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 467ceed8771e7004ca9377c6cbbd4b59, type: 3}
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u679C\u7136\u662F\u8FD9\u6837\u5462\uFF01\u770B\u6211\u628A\u4F60\u526A\u6210\u4E24\u534A\uFF01"
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: de4f455b1c2d4ee4183867a02c35d8d9, type: 3}
  - playerName: Cutman
    playerKey: Cutman
    dialogueLines:
    - speakerName: "\u526A\u5200\u4EBA\uFF1F"
      text: "\u54DF\uFF0C\u539F\u578B\uFF01\u5934\u4E0A\u957F\u7740\u526A\u5200\u7684\u5BB6\u4F19\uFF0C\u771F\u5371\u9669\u5450"
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 983ae1cda94e79042891af56bd194d43, type: 3}
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u662F\u6211\u7684\u4EFF\u5236\u54C1\u5417\uFF1F\uFF01\u505A\u5F97\u8FD8\u633A\u50CF\u7684\u554A~"
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 85c12013a531ddc4497d0e9be130b842, type: 3}
    - speakerName: "\u526A\u5200\u4EBA\uFF1F"
      text: "...\u4F60\u5C31\u7B97\u4F1A\u7528\u526A\u5200\uFF0C\u5374\u53EA\u662F\u4E2A\u7B28\u86CB\u7F62\u4E86..."
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 00000f8bc94cdf245a75cca654a8ce69, type: 3}
  - playerName: Gutsman
    playerKey: Gutsman
    dialogueLines:
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u5C45\u7136\u6765\u7834\u574F\u5728\u8FD9\u91CC\u5DE5\u4F5C\u7684\u4F19\u4F34\u4EEC\u2026\u5A01\u5229\u535A\u58EB\u8BF4\u7684\u90FD\u662F\u771F\u7684\u5417?..."
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: a2fe6f8da8f3eb54b8707102058d7cb2, type: 3}
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u55EF\uFF1F\u53D1\u751F\u5565\u4E86\uFF1F"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: d458750cc6ebde54389f472a71163afa, type: 3}
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u201D\u8001\u54E5\u88AB\u6539\u9020\u6210\u4E86\u90AA\u6076\u7684\u6218\u6597\u673A\u5668\u4EBA,\u5728\u8FD9\u5468\u56F4\u5230\u5904\u641E\u7834\u574F...\u201C\u6211\u8981\u963B\u6B62\u8001\u54E5,\u8BA9\u4F60\u6062\u590D\u6B63\u5E38\uFF01"
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 85a5fc9e2ec8ca24bb9687a5956cce91, type: 3}
  - playerName: Iceman
    playerKey: Iceman
    dialogueLines:
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u542C\u8BF4\u5C31\u662F\u4F60\u8FD9\u4E2A\u5C0F\u5BB6\u4F19\u5230\u5904\u628A\u4E1C\u897F\u90FD\u51BB\u6210\u51B0\u5757\u7684\u554A\uFF1F"
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: a9687c3e62a3b62448cbf9cb5929b043, type: 3}
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u8FD9\u4E2A...\u90A3\u4E2A...\u6CA1 \u6CA1\u6709\u8FD9\u56DE\u4E8B\u54E6\uFF01"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 5e581bf3fa2389e41928351e398186c9, type: 3}
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u5C0F\u5F1F\u505A\u4E86\u574F\u4E8B\uFF0C\u5C31\u7531\u6211\u8FD9\u4E2A\u5927\u54E5\u6765\u60E9\u7F5A\uFF01\u526A\u6210\u4E24\u534A\u4E4B\u5211\uFF01"
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 41c29705285ff9f42be14bda775685b2, type: 3}
  - playerName: Bombman
    playerKey: Bombman
    dialogueLines:
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u5A01\u5229\u535A\u58EB\u8BF4\u7684\u90FD\u662F\u771F\u7684\u5417?...\u8001\u54E5\u88AB\u6539\u9020\u6210\u4E86\u90AA\u6076\u7684\u6218\u6597\u673A\u5668\u4EBA,\u5728\u8FD9\u5468\u56F4\u5230\u5904\u641E\u7834\u574F..."
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: ba97671cc847a7643908c0f7f8282e9a, type: 3}
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u6DF7\u8D26\u4E1C\u897F\uFF01\u8001\u5B50\u884C\u5F97\u6B63\u5750\u5F97\u76F4\uFF0C\u6CA1\u5E72\u8FC7\u89C1\u4E0D\u5F97\u4EBA\u7684\u4E8B\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 229233e1f515d204b890a77b50579458, type: 3}
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u54EA\u6015\u526A\u6210\u4E24\u534A\uFF0C\u6211\u4E5F\u8981\u8BA9\u8001\u54E5\u6062\u590D\u6B63\u5E38\uFF01"
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 69caf0538f5c256428d148954cd9fb13, type: 3}
  - playerName: Fireman
    playerKey: Fireman
    dialogueLines:
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u5A01\u5229\u535A\u58EB\u8BF4\u7684\u90FD\u662F\u771F\u7684\u5417?...\u8001\u54E5\u88AB\u6539\u9020\u6210\u4E86\u90AA\u6076\u7684\u6218\u6597\u673A\u5668\u4EBA,\u5728\u8FD9\u5468\u56F4\u5230\u5904\u641E\u7834\u574F..."
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: ba97671cc847a7643908c0f7f8282e9a, type: 3}
    - speakerName: "\u706B\u7130\u4EBA"
      text: "\u71C3\u70E7\u5427\uFF01\u71C3\u70E7\u7740\u7684\u4E43\u6B63\u4E49\u4E4B\u708E\uFF01\u6765\u4E00\u51B3\u9AD8\u4E0B\uFF0C\u770B\u770B\u4F60\u6211\u7684\u6B63\u4E49\u8C01\u66F4\u70BD\u70ED\u5427\uFF01"
      speakerPortrait: {fileID: 104266460, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: a39ff1b0306f0ba4bb147f625e1ce965, type: 3}
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u54E6\u563F\uFF01\uFF1F\u4E24\u8FB9\u90FD\u662F\u6B63\u4E49\u7684\u8BDD\uFF0C\u90A3\u5C31\u53EA\u80FD\u6253\u4E00\u573A\u4E86\u554A\uFF01"
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: ed4221291ea5f6449b3f62f1e05c4d0b, type: 3}
  - playerName: Elecman
    playerKey: Elecman
    dialogueLines:
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u5C45\u7136\u6765\u7834\u574F\u5728\u8FD9\u91CC\u5DE5\u4F5C\u7684\u4F19\u4F34\u4EEC\u2026\u5A01\u5229\u535A\u58EB\u8BF4\u7684\u90FD\u662F\u771F\u7684\u5417?..."
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 128d75c146b08c34c8ad7fbfede0aac9, type: 3}
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u7F8E\u4E3D\u5F97\u4EE4\u4EBA\u53D1\u9EBB\u5427\uFF1F\u6211\u7684\u6218\u59FF"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: d63c5cdb39aceec4da6c105b9f6f3616, type: 3}
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u54EA\u6015\u526A\u6210\u4E24\u534A\uFF0C\u6211\u4E5F\u8981\u8BA9\u8001\u54E5\u6062\u590D\u6B63\u5E38\uFF01"
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 69caf0538f5c256428d148954cd9fb13, type: 3}
  fillHealthSfx: {fileID: 8300000, guid: ca146d40119cf9443966cf3a809e6558, type: 3}
