--- !u!114 &1515125691
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1515125688}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc8dbd3ceff49e04c90252d7d455d391, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  playerSpawnPoint: {fileID: 2137578414}
  gutsmanSpawnPoint: {fileID: 1520390634}
  player: {fileID: 0}
  gutsmanMelee: {fileID: 0}
  boss: {fileID: 4872820593799827822}
  bossDoor: {fileID: 310074011}
  bossHealthContainer: {fileID: 1356010325}
  mainCamera: {fileID: 0}
  bossCamera: {fileID: 1300969408}
  bgmSource: {fileID: 694827746}
  bossBgm: {fileID: 8300000, guid: fe523e247d8242e48a2f87ec799c4af1, type: 3}
  dialogueManager: {fileID: 1515125693}
  dialoguePanel: {fileID: 1407828938}
  dialogues:
  - playerName: Rockman
    playerKey: Rockman
    dialogueLines:
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u771F\u9AD8\u5174\u4F60\u80FD\u6765\u5462...\u4E0D\u8FC7\u9A6C\u4E0A\u5C31\u662F\u544A\u522B\u4E86\u54DF\u3002\u6700\u540E\u6765\u70B9\u7EDA\u4E3D\u7684\u53F0\u8BCD\u8BA9\u6211\u542C\u542C\u770B\u5427"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 1332c92358b6c194dae136b1e8097bf9, type: 3}
    - speakerName: "\u6D1B\u514B\u4EBA"
      text: "\u7535\u529B\u4EBA\uFF01\u6211\u6CA1\u6709\u548C\u4F60\u6218\u6597\u7684\u7406\u7531\u554A\uFF01\u6765\uFF0C\u4E00\u8D77\u56DE\u5BB6\u5427\uFF01\uFF1F"
      speakerPortrait: {fileID: -1505411928, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: ad2ed0550cd19c94fb97001f1d9acfa0, type: 3}
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u5149\u9760\u8FD9\u6837\u7684\u53F0\u8BCD\u53EF\u6CA1\u6CD5\u5C04\u4E2D\u6211\u7684\u5FC3\u54DF\u3002\u6CA1\u529E\u6CD5\uFF0C\u53EA\u597D\u7535\u5149\u77F3\u706B\u822C\u5730\u89E3\u51B3\u6389\u4E86"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: b93ed1410a979f741829658f4fc9a876, type: 3}
  - playerName: Blues
    playerKey: Blues
    dialogueLines:
    - speakerName: "\u7535\u529B\u4EBA"
      text: "...\u6D1B\u514B\uFF1F\u4E0D\uFF0C\u4E0D\u5BF9\u5462\u3002\u4F46\u662F\u786E\u5B9E\u5F88\u50CF...\u90A3\u4EE4\u4EBA\u53D1\u9EBB\u822C\u7684\u7F8E\u4E3D..."
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: b29e0e736d42ca8498ac67520a7b2bfa, type: 3}
    - speakerName: "\u5E03\u9C81\u65AF"
      text: "\u7535\u529B\u4EBA...\u62B1\u6B49\uFF0C\u6211\u6CA1\u6CD5\u624B\u4E0B\u7559\u60C5..."
      speakerPortrait: {fileID: 1110756348, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 0a9ec135176b1194e815e46b4a7eb534, type: 3}
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u4EFF\u4F5B\u6709\u7535\u6D41\u4ECE\u5934\u5230\u811A\u5954\u6D8C\u800C\u8FC7...\u4F1A\u662F\u4E00\u573A\u5F88\u68D2\u7684\u6218\u6597\u5462..."
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: d2736a95aefe5c644b600d880e336cef, type: 3}
  - playerName: Cutman
    playerKey: Cutman
    dialogueLines:
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u554A...\u5F3A\u70C8\u5230\u8BA9\u6211\u9EBB\u75F9\u7684\u611F\u89C9...\u4F60\u90A3\u8FF7\u60D8\uFF0C\u7126\u6025\uFF0C\u56F0\u60D1\u7684\u60C5\u7EEA\u554A\u2026"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 39d2e5abc2774ff48a41f2a2717d32b7, type: 3}
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u7535 \u7535\u529B\u5927\u54E5\uFF01\u597D\u597D\u542C\u6211\u628A\u8BDD\u8BF4\u5B8C\u5427\uFF01"
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: e15f04b1b145cae44b0ac9f5e123b847, type: 3}
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u4EFF\u4F5B\u6709\u7535\u6D41\u4ECE\u5934\u5230\u811A\u5954\u6D8C\u800C\u8FC7...\u8BA9\u6211\u542C\u542C\u90A3\u7EDD\u7F8E\u7684\u60B2\u9E23\u5427\u2026"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 5b456d5fa4500114288dd787a2d25d64, type: 3}
  - playerName: Gutsman
    playerKey: Gutsman
    dialogueLines:
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u554A\u554A\uFF0C\u7535\u8DEF\u90FD\u5FEB\u8981\u70E7\u574F\u7684\u7A0B\u5EA6\uFF0C\u5F3A\u70C8\u5730\u9707\u52A8\u7740\u554A...\u4F60\u90A3\u7C97\u72B7\u7684\u96F7\u9E23\u4E4B\u58F0"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: ed03913681c5777428ca29e75f2f4d51, type: 3}
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u641E\u5565\u554A\uFF0C\u7535\u529B\u4EBA\u2026\u2026\u4F60\u8FD8\u662F\u8001\u6837\u5B50\uFF0C\u51C0\u8BF4\u4E9B\u8BA9\u4EBA\u542C\u4E0D\u61C2\u7684\u8BDD"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 186f062cc5fe3574f889d31a5972bdd0, type: 3}
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u5728\u5206\u5D29\u79BB\u6790\u4E4B\u65F6\uFF0C\u8BA9\u6211\u542C\u542C\u90A3\u7EDD\u7F8E\u7684\u60B2\u9E23\u5427\u2026"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: f9d482cff9b3296408c9369b6d149b98, type: 3}
  - playerName: Iceman
    playerKey: Iceman
    dialogueLines:
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u53EF\u7231\u7684\u51B0\u4E4B\u5996\u7CBE\u554A...\u6211\u4F1A\u4E3A\u4F60\u732E\u4E0A\u8DB3\u4EE5\u8BA9\u7535\u8DEF\u70E7\u574F\u7684\u9EBB\u75F9\u611F\u54E6"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 926072294ad08304abb189f305ca4c9f, type: 3}
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u6211...\u6211\u4E0D\u60F3\u9EBB\u75F9\u5566~"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 822f049be1b0a7544b0d9e372027c604, type: 3}
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u4EFF\u4F5B\u6709\u7535\u6D41\u4ECE\u5934\u5230\u811A\u5954\u6D8C\u800C\u8FC7...\u8BA9\u6211\u542C\u542C\u90A3\u7EDD\u7F8E\u7684\u60B2\u9E23\u5427\u2026"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 5b456d5fa4500114288dd787a2d25d64, type: 3}
  - playerName: Bombman
    playerKey: Bombman
    dialogueLines:
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u5509\uFF0C\u4F55\u7B49\u7684\u4E11\u964B\u554A\u2026\u5C31\u8BA9\u4F60\u5728\u7535\u5149\u706B\u77F3\u95F4\u6D88\u6563\u5427\u2026"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: a535ce4f08b96864e99daea839e5cf00, type: 3}
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u6DF7\u8D26\u4E1C\u897F\uFF01\u867D\u7136\u8001\u5B50\u5916\u8868\u8FD9\u6837\u4F46\u662F\u5185\u5FC3\u521A\u5F3A\u8C6A\u723D\uFF01\u81ED\u5C0F\u5B50\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 882b061332185e0458aae7acbcc8d223, type: 3}
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u81F3\u5C11\u8BA9\u4F60\u5728\u4E34\u7EC8\u7684\u77AC\u95F4\uFF0C\u5982\u70DF\u82B1\u822C\u7F8E\u4E3D\u5730\u7EFD\u653E\u5427\u2026"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 22d235ccea232fb4cb40f54cee9a1c42, type: 3}
  - playerName: Fireman
    playerKey: Fireman
    dialogueLines:
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u771F\u9AD8\u5174\u4F60\u80FD\u6765\u5462...\u4E0D\u8FC7\u9A6C\u4E0A\u5C31\u662F\u544A\u522B\u4E86\u54DF\u3002\u6700\u540E\u6765\u70B9\u7EDA\u4E3D\u7684\u53F0\u8BCD\u8BA9\u6211\u542C\u542C\u770B\u5427"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 1332c92358b6c194dae136b1e8097bf9, type: 3}
    - speakerName: "\u706B\u7130\u4EBA"
      text: "\u71C3\u70E7\u5427\uFF01"
      speakerPortrait: {fileID: 104266460, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 7023e512bfa146546b8c3c94d62eaf86, type: 3}
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u5F88\u4E0D\u9519\u54DF\u706B\u7130\u4EBA...\u5C31\u50CF\u6709\u96F7\u7535\u8D2F\u7A7F\u4E86\u6211\u7684\u5168\u8EAB\u2026\u63A5\u4E0B\u6765\uFF0C\u5C31\u8F6E\u5230\u4F60\u6765\u5C1D\u5C1D\u8FD9\u79CD\u6ECB\u5473\u4E86\u2026"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 26d2814f214d81847a375002335b91e9, type: 3}
  - playerName: Elecman
    playerKey: Elecman
    dialogueLines:
    - speakerName: "\u7535\u529B\u4EBA\uFF1F"
      text: "\u54DF\uFF0C\u539F\u578B\uFF01\u542C\u8BF4\u4F60\u662F\u4E2A\u5F88\u4F18\u79C0\u7684\u673A\u5668\u4EBA\u554A\uFF1F\u771F\u8BA9\u6211\u9AD8\u5174\uFF01"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: b4bcccadcf6d04c48b851e0a795328f6, type: 3}
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u4F5C\u4E3A\u6211\u7684\u4EFF\u5236\u54C1\uFF0C\u7B80\u76F4\u4E0D\u582A\u5165\u76EE..."
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 38d28026f850e7f4f9ae6840f246aa44, type: 3}
    - speakerName: "\u7535\u529B\u4EBA\uFF1F"
      text: "\u4F60\u90A3\u50B2\u6162\u7684\u53E3\u6C14\u6211\u4E5F\u80FD\u6A21\u4EFF\u54E6\uFF01\u201C\u7535\u5149\u77F3\u706B\u822C\u5730\u628A\u4F60\u89E3\u51B3\u6389\u201D...\u5417\uFF01\uFF1F"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: f127cc6b9fdbb0b46a72197df31cff47, type: 3}
  fillHealthSfx: {fileID: 8300000, guid: ca146d40119cf9443966cf3a809e6558, type: 3}
  doorSfx: {fileID: 8300000, guid: 11f8762caa2a9b845bdcec68ca3da5be, type: 3}
