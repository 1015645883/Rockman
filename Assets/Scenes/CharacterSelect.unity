    description: "\u6838\u80FD\u53D1\u7535\u5382\u7BA1\u7406\u673A\u5668\u4EBA\u3002\u53EF\u4EE5\u6D88\u8017\u7535\u529B\u4ECE\u624B\u90E8\u4EA7\u751F\u4E09\u65B9\u5411\u7684\u7535\u6D41\u3002\u53EF\u4EE5\u8FDB\u884C\u51B2\u523A\u3002\u5177\u6709\u8F83\u5F3A\u7684\u79FB\u52A8\u901F\u5EA6\u548C\u8DF3\u8DC3\u529B\u3002\u53EF\u4EE5\u6309O\u6301\u7EED\u6D88\u8017\u7535\u529B\u4F7F\u81EA\u8EAB\u5177\u6709\u66F4\u5F3A\u7684\u673A\u52A8\u6027\u3002\u5FEB\u901F\u53CC\u51FB\u4E0B\u65B9\u5411\u952E\u53EF\u4EE5\u8FDB\u884C\u5145\u7535\u3002"
