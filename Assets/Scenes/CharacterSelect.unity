  - key: Fireman
    displayName: "DRN.007.\u706B\u7130\u4EBA"
    description: "\u5E9F\u5F03\u7269\u711A\u70E7\u5904\u7406\u673A\u5668\u4EBA\u3002\u53EF\u4EE5\u5728\u5934\u90E8\u548C\u53CC\u624B\u4EA7\u751F\u7A7F\u900F\u529B\u5F3A\u7684\u706B\u7130\u3002\u84C4\u529B\u540E\u5177\u6709\u66F4\u5927\u7684\u8303\u56F4\u5E76\u4F1A\u5728\u81EA\u8EAB\u5468\u56F4\u4EA7\u751F\u706B\u7130\u98CE\u66B4\u3002\u5177\u6709\u5F88\u5F3A\u7684\u8010\u70ED\u6027\u3002"
