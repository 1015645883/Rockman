  - key: Blues
    displayName: "DRN.000.\u5E03\u9C81\u65AF"
    description: "\u83B1\u7279\u535A\u58EB\u5F00\u53D1\u7684\u539F\u578B\u673A\u5668\u4EBA\u3002\u53EF\u4EE5\u4F7F\u7528\u5E03\u9C81\u65AF\u70AE\u8FDB\u884C\u653B\u51FB\uFF0C\u84C4\u529B\u540E\u4F1A\u6709\u66F4\u5F3A\u7684\u5A01\u529B\u548C\u7A7F\u900F\u529B\u3002\u84C4\u529B\u901F\u5EA6\u8F83\u5FEB\u3002\u9632\u5FA1\u529B\u8F83\u5F31\u3002\u53EF\u4EE5\u8FDB\u884C\u51B2\u523A\u3002\u88C5\u914D\u6709\u6B66\u5668\u590D\u5236\u7CFB\u7EDF\u548C\u5E03\u9C81\u65AF\u76FE\u724C\u3002"
    bigSprite: {fileID: 1528363295, guid: 9a601e60f33d8f146808d44abb0fc0a9, type: 3}
    iconSprite: {fileID: 1110756348, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
    displaySize: {x: 950, y: 950}
    confirmVoice: {fileID: 8300000, guid: 46ce21d4acd45284288e05214e9fcebb, type: 3}
  - key: Cutman
    displayName: "DRN.003.\u526A\u5200\u4EBA"
    description: "\u68EE\u6797\u6728\u6750\u91C7\u4F10\u4F5C\u4E1A\u7528\u673A\u5668\u4EBA\u3002\u53EF\u4EE5\u4EE5\u591A\u79CD\u65B9\u5F0F\u6295\u63B7\u51FA\u56DE\u65CB\u526A\u5200\uFF0C\u5BF9\u654C\u4EBA\u6301\u7EED\u9020\u6210\u4F24\u5BB3\u3002\u53EF\u4EE5\u8FDB\u884C\u51B2\u523A\u3002\u8EAB\u4F53\u8F7B\u76C8\uFF0C\u8DF3\u8DC3\u529B\u6781\u5F3A\u3002\u53EF\u4EE5\u6500\u722C\u5899\u58C1\u5E76\u4E14\u5728\u5899\u58C1\u4E0A\u518D\u6B21\u8DF3\u8DC3\u6216\u8005\u653B\u51FB\u3002"
    bigSprite: {fileID: 21300000, guid: ee8bb82c3c3e10d4689004bd58be7b5b, type: 3}
    iconSprite: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
    displaySize: {x: 1000, y: 1000}
    confirmVoice: {fileID: 8300000, guid: 3938ca3f534f3e047b8f98b29085f9dd, type: 3}
  - key: Gutsman
    displayName: "DRN.004.\u6C14\u529B\u4EBA"
    description: "\u571F\u6728\u5DE5\u7A0B\u4F5C\u4E1A\u7528\u673A\u5668\u4EBA\u3002\u53EF\u4EE5\u6253\u51FA\u5F3A\u529B\u7684\u62F3\u51FB\uFF0C\u5728\u7A7A\u4E2D\u53EF\u4EE5\u4F7F\u51FA\u80FD\u591F\u4F7F\u654C\u4EBA\u9707\u64BC\u7684\u5730\u9707\u8E29\u8E0F\u3002\u7A33\u5B9A\u6027\u5F3A\uFF0C\u53D7\u4F24\u4E0D\u4F1A\u4EA7\u751F\u786C\u76F4\u3002"
    bigSprite: {fileID: 21300000, guid: 03754ae3ef4b7584c8fc2a7e3fb43e1e, type: 3}
    iconSprite: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
    displaySize: {x: 950, y: 950}
    confirmVoice: {fileID: 8300000, guid: 1e90c35f6b35ba54ebd6fd00cf090a5e, type: 3}
  - key: Iceman
    displayName: "DRN.005.\u51B0\u96EA\u4EBA"
    description: "\u5357\u6781\u63A2\u52D8\u8C03\u67E5\u7528\u7684\u5BD2\u5730\u578B\u673A\u5668\u4EBA\u3002\u53EF\u4EE5\u4ECE\u53E3\u4E2D\u53D1\u5C04\u51FA\u51BB\u7ED3\u654C\u4EBA\u7684\u5BD2\u51B0\u7BAD\u3002\u5177\u6709\u826F\u597D\u7684\u8010\u70ED\u6027\u548C\u8010\u5BD2\u6027\u3002\u53EF\u4EE5\u8FDB\u884C\u51B2\u523A\u3002"
    bigSprite: {fileID: 21300000, guid: 50f70788a5806aa4d9985d42cafd84c2, type: 3}
    iconSprite: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
    displaySize: {x: 950, y: 950}
    confirmVoice: {fileID: 8300000, guid: ced83a0c534dd1e41b42a5b7584ef6ab, type: 3}
  - key: Bombman
    displayName: "DRN.006.\u70B8\u5F39\u4EBA"
    description: "\u571F\u5730\u5F00\u62D3\u5DE5\u7A0B\u4F5C\u4E1A\u7528\u673A\u5668\u4EBA\u3002\u53EF\u4EE5\u5411\u591A\u65B9\u5411\u6295\u63B7\u51FA\u7834\u574F\u529B\u5F3A\u5927\u7684\u9AD8\u80FD\u70B8\u5F39\u3002\u84C4\u529B\u653B\u51FB\u53EF\u4EE5\u5C06\u81EA\u5DF1\u70B8\u98DE\u3002\u5177\u6709\u5BF9\u7206\u70B8\u653B\u51FB\u7684\u6297\u6027\u3002"
    bigSprite: {fileID: 21300000, guid: 5c0e0bbd1423d7e468cd944c50587959, type: 3}
