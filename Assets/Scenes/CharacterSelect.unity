  - key: Rockman
    displayName: "DRN.001.\u6D1B\u514B\u4EBA"
    description: "\u5BB6\u52A1\u578B\u673A\u5668\u4EBA\u3002\u53EF\u4EE5\u4F7F\u7528\u6D1B\u514B\u70AE\u8FDB\u884C\u653B\u51FB\uFF0C\u84C4\u529B\u540E\u5177\u6709\u66F4\u5F3A\u7684\u5A01\u529B\u548C\u7A7F\u900F\u529B\u3002\u53EF\u4EE5\u8FDB\u884C\u51B2\u523A\u3002\u88C5\u914D\u6709\u6B66\u5668\u590D\u5236\u7CFB\u7EDF\u3002"
    bigSprite: {fileID: 21300000, guid: ded0efb4cd2fbbe41b7b230a9c5a9a3d, type: 3}
