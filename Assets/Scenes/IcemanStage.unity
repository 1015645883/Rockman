  bgmSource: {fileID: 992660405}
  bossBgm: {fileID: 8300000, guid: fe523e247d8242e48a2f87ec799c4af1, type: 3}
  dialogueManager: {fileID: 835500436}
  dialoguePanel: {fileID: 1519882669}
  dialogues:
  - playerName: Rockman
    playerKey: Rockman
    dialogueLines:
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u554A~\u8FD9\u91CC\u5F88\u5371\u9669\u54E6 \u6B38~\u5728\u8FD9\u91CC\u8F6C\u60A0\u7684\u8BDD\u4F1A\u88AB\u51BB\u6210\u51B0\u5757\u7684"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 45869a698ea4234459403a3e728e80ad, type: 3}
    - speakerName: "\u6D1B\u514B\u4EBA"
      text: "\u600E\u4E48\u4F1A...\u51B0\u96EA\u4EBA\uFF01\u50CF\u4F60\u8FD9\u6837\u6587\u9759\u8001\u5B9E\u7684\u673A\u5668\u4EBA\u4E5F..."
      speakerPortrait: {fileID: -1505411928, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 78653779cc3582746b44f7fd7349c200, type: 3}
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u554A~\u8FD9\u6837\u7684\u8BDD\u6211\u5C31 \u6B38~\u5F00\u59CB\u6267\u884C\u4EFB\u52A1"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: bf6f1fe3cf45e574bb63aaad2128b8dd, type: 3}
  - playerName: Blues
    playerKey: Blues
    dialogueLines:
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u554A~\u8FD9\u91CC\u5F88\u5371\u9669\u54E6 \u6B38~\u5728\u8FD9\u91CC\u8F6C\u60A0\u7684\u8BDD\u4F1A\u88AB\u51BB\u6210\u51B0\u5757\u7684"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 45869a698ea4234459403a3e728e80ad, type: 3}
    - speakerName: "\u5E03\u9C81\u65AF"
      text: "\u51B0\u96EA\u4EBA...\u53EF\u80FD\u4F1A\u6709\u70B9\u75DB...\u5FCD\u8010\u4E00\u4E0B\u5427..."
      speakerPortrait: {fileID: 1110756348, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 68363843b13e27f4ab6f7bc5781ae958, type: 3}
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u6211\u53EF\u4E0D\u60F3\u75BC\u75DB\u5566~\u5C31\u7B97\u8FD9\u6837\uFF0C\u6211\u4E5F\u8981\u6267\u884C\u4EFB\u52A1"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 4a206bb8877c06a4f8f3ff898a45c8fc, type: 3}
  - playerName: Cutman
    playerKey: Cutman
    dialogueLines:
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u554A~\u8FD9\u91CC\u5F88\u5371\u9669\u54E6 \u6B38~\u5728\u8FD9\u91CC\u8F6C\u60A0\u7684\u8BDD\u4F1A\u88AB\u51BB\u6210\u51B0\u5757\u7684"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 45869a698ea4234459403a3e728e80ad, type: 3}
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u4EC0\u4E48\u610F\u601D\uFF01\uFF1F\u4F60\u662F\u53EB\u6211\u6EDA\u5417\uFF1F\u4F60\u8FD9\u5C0F\u5B50\u53EF\u771F\u56A3\u5F20\u554A\uFF01"
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: e2d5d815bafc8da43a922012401d8bb1, type: 3}
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u554A~\u5E76\u4E0D\u662F\u8FD9\u6837\u7684\uFF01\u6B38~\u8FD9\u662F\u975E\u5E38\u91CD\u8981\u7684\u4EFB\u52A1\uFF01"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 83418e4e40fbb8d4a8b3d9b823bf3408, type: 3}
  - playerName: Gutsman
    playerKey: Gutsman
    dialogueLines:
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u554A~\u8FD9\u91CC\u5F88\u5371\u9669\u54E6 \u6B38~\u5728\u8FD9\u91CC\u8F6C\u60A0\u7684\u8BDD\u4F1A\u88AB\u51BB\u6210\u51B0\u5757\u7684"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 45869a698ea4234459403a3e728e80ad, type: 3}
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u8EAB\u4E3A\u5DE5\u5934\u7684\u6211\uFF0C\u56FE\u7EB8\u4E0A\u53EF\u4E0D\u4F1A\u6709\u90A3\u79CD\u60C5\u51B5\uFF01"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: f27c2e1d185438d4c9b8a3eac2712038, type: 3}
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u554A~\u8FD9\u6837\u7684\u8BDD\u8BA1\u5212\u6709\u53D8\uFF01\u6211\u4F1A\u6765\u628A\u60A8\u51BB\u6210\u51B0\u5757\uFF01"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: ea4c6d7c665d2404e97b03ad098d211b, type: 3}
  - playerName: Iceman
    playerKey: Iceman
    dialogueLines:
    - speakerName: "\u51B0\u96EA\u4EBA\uFF1F"
      text: "\u54DF\uFF0C\u539F\u578B\uFF01\u52A8\u4E0D\u52A8\u5C31\u628A\u522B\u4EBA\u51B0\u51BB\u4F4F\u8FDE\u8BDD\u90FD\u8BF4\u4E0D\u51FA\uFF0C\u4F60\u8FD8\u88C5\u5F97\u50CF\u4E2A\u4E56\u5B69\u5B50\uFF0C\u4E0D\u89C9\u5F97\u5F88\u80AE\u810F\u5417\uFF1F"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 0ff0104341efeb54fb6159f73b510f8f, type: 3}
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u54CE\u5440\uFF0C\u8FD9\u4E2A\u5C0F\u73A9\u5177\u505A\u5DE5\u771F\u4E0D\u9519
        \u597D\u60F3\u51BB\u5F97\u786C\u90A6\u90A6\u5E26\u56DE\u5BB6\u53BB"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 7447c5fca580cf0449030ea43d04fda0, type: 3}
    - speakerName: "\u51B0\u96EA\u4EBA\uFF1F"
      text: "\u6B38\uFF01\uFF1F\u7B49 \u7B49\u4E00\u4E0B\uFF01\uFF01\uFF01"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 8c7b1f12a2bd9bb49a67eb3274780aca, type: 3}
  - playerName: Bombman
    playerKey: Bombman
    dialogueLines:
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u554A~\u8FD9\u91CC\u5F88\u5371\u9669\u54E6 \u6B38~\u5728\u8FD9\u91CC\u8F6C\u60A0\u7684\u8BDD\u4F1A\u88AB\u51BB\u6210\u51B0\u5757\u7684"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 45869a698ea4234459403a3e728e80ad, type: 3}
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u80E1\u8BF4\u516B\u9053\u5565\u5462\uFF01\u8C01\u4F1A\u660E\u77E5\u9053\u5371\u9669\u8FD8\u5F80\u4E0A\u51D1\uFF01\u8001\u5B50\u8981\u628A\u4F60\u548C\u4F60\u90A3\u9AA8\u6C14\u4E00\u8D77\u70B8\u98DE\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 3d388138b69ba234a89465223d9c70ba, type: 3}
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u554A~\u5C31\u7B97\u8FD9\u6837\u6211\u4E5F\u8981  \u6B38~\u5F00\u59CB\u6267\u884C\u4EFB\u52A1"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 42bd77bed26376143b19648f4bd7d180, type: 3}
  - playerName: Fireman
    playerKey: Fireman
    dialogueLines:
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u554A~\u8FD9\u91CC\u5F88\u5371\u9669\u54E6 \u6B38~\u5728\u8FD9\u91CC\u8F6C\u60A0\u7684\u8BDD\u4F1A\u88AB\u51BB\u6210\u51B0\u5757\u7684"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 45869a698ea4234459403a3e728e80ad, type: 3}
    - speakerName: "\u706B\u7130\u4EBA"
      text: "\u5F88\u51B7\u5417\uFF01\uFF1F\u6CA1\u6709\u71C3\u8D77\u6765\u5417\uFF01\uFF1F\u6211\u53EF\u71C3\u8D77\u6765\u4E86\uFF01\u5DF2\u7ECF\u71C3\u8D77\u6765\u4E86\uFF01\uFF01"
      speakerPortrait: {fileID: 104266460, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: df9ef00871439a44f9a37f19426b7e14, type: 3}
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u6B38\uFF01\uFF1F\u8FD9 \u8FD9\u662F\u4EC0\u4E48\u610F\u601D\uFF01\uFF1F...\u6211\u4F1A\u7528\u5168\u529B\u628A\u4F60\u51BB\u6210\u51B0\u5757\u7684\uFF01"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: ff6af656dd726834ebdfdd8e089985d6, type: 3}
  - playerName: Elecman
    playerKey: Elecman
    dialogueLines:
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u554A~\u8FD9\u91CC\u5F88\u5371\u9669\u54E6 \u6B38~\u5728\u8FD9\u91CC\u8F6C\u60A0\u7684\u8BDD\u4F1A\u88AB\u51BB\u6210\u51B0\u5757\u7684"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 45869a698ea4234459403a3e728e80ad, type: 3}
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u51BB\u5F97\u51B0\u51C9\u900F\u9876\u2026\u771F\u8BA9\u4EBA\u53D1\u9EBB\u554A\uFF0C\u7EDD\u4F73\u7684\u8868\u73B0\u2026\u8981\u963B\u6B62\u4F60\uFF0C\u771F\u662F\u8BA9\u6211\u5FC3\u75DB\u554A\u2026"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 7e8d06c4cd5862b47bfef0d06fc8bfa0, type: 3}
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u554A~\u8FD9\u6837\u7684\u8BDD\u6211\u5C31 \u6B38~\u5F00\u59CB\u6267\u884C\u4EFB\u52A1"
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: bf6f1fe3cf45e574bb63aaad2128b8dd, type: 3}
