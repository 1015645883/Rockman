  bossCamera: {fileID: 372184853}
  bgmSource: {fileID: 2079755361}
  bossBgm: {fileID: 8300000, guid: fe523e247d8242e48a2f87ec799c4af1, type: 3}
  dialogueManager: {fileID: 959274091}
  dialoguePanel: {fileID: 1430483520}
  dialogues:
  - playerName: Rockman
    playerKey: Rockman
    dialogueLines:
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u641E\u5565\u5B50\u561B\uFF0C\u600E\u4E48\u5C0F\u9B3C\u4F1A\u51FA\u73B0\u5728\u8FD9\u79CD\u5730\u65B9\u3002\u8FD9\u91CC\u662F\u5C5E\u4E8E\u7537\u5B50\u6C49\u7684\u5DE5\u5730\u55F7\uFF01\u4E0D\u60F3\u53D7\u4F24\u7684\u8BDD\u5C31\u8D76\u5FEB\u6EDA\u51FA\u53BB\uFF01"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: d14d5b5d2f9c36446abc3351bdf3c4b1, type: 3}
    - speakerName: "\u6D1B\u514B\u4EBA"
      text: "\u6C14\u529B\u4EBA\uFF01\u591F\u4E86\uFF01\u505C\u6B62\u65BD\u5DE5\u5427\uFF01"
      speakerPortrait: {fileID: -1505411928, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: de146ca037bc77b45b44090f5e8cb67b, type: 3}
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u5927\u50BB\u5E3D\uFF01\u4F5C\u4E3A\u5DE5\u5934\u7684\u6211\u653E\u4E0B\u5DE5\u5730\u4E0D\u7BA1\u90A3\u53EF\u600E\u4E48\u884C\uFF1F\u6211\u8FD9\u5C31\u628A\u4F60\u8D76\u51FA\u53BB\uFF01"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 7bd3bd812daad1e4b9b0fb77712d689c, type: 3}
  - playerName: Blues
    playerKey: Blues
    dialogueLines:
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u5728\u6211\u5DE5\u5730\u6363\u4E71\u7684\u662F\u54EA\u4E2A\u5BB6\u4F19\uFF01\uFF1F"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 596bd509469a85241b3aabdd1af48ed9, type: 3}
    - speakerName: "\u5E03\u9C81\u65AF"
      text: "...\u505C\u624B\u5427... \u4F60\u7684\u5DE5\u5730\u4E0D\u5E94\u8BE5\u5728\u8FD9\u91CC"
      speakerPortrait: {fileID: 1110756348, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 8dd8c4f467967a8449b603d5a74a7610, type: 3}
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u5927\u50BB\u5E3D\uFF01\u4F5C\u4E3A\u5DE5\u5934\u7684\u6211\u653E\u4E0B\u5DE5\u5730\u4E0D\u7BA1\u90A3\u53EF\u600E\u4E48\u884C\uFF1F\u6211\u8FD9\u5C31\u628A\u4F60\u8D76\u51FA\u53BB\uFF01"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 7bd3bd812daad1e4b9b0fb77712d689c, type: 3}
  - playerName: Cutman
    playerKey: Cutman
    dialogueLines:
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u641E\u5565\u5B50\u561B\uFF0C\u600E\u4E48\u5C0F\u9B3C\u4F1A\u51FA\u73B0\u5728\u8FD9\u79CD\u5730\u65B9\u3002\u8FD9\u91CC\u662F\u5C5E\u4E8E\u7537\u5B50\u6C49\u7684\u5DE5\u5730\u55F7\uFF01\u4E0D\u60F3\u53D7\u4F24\u7684\u8BDD\u5C31\u8D76\u5FEB\u6EDA\u51FA\u53BB\uFF01"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: d14d5b5d2f9c36446abc3351bdf3c4b1, type: 3}
    - speakerName: "\u526A\u5200\u4EBA"
      text: "\u660E\u660E\u662F\u4EE5\u524D\u90A3\u4E48\u6E29\u67D4\u7684\u6C14\u529B\u5927\u54E5\u2026\u6211\u4E00\u5B9A\u8981\u628A\u4F60\u5E26\u56DE\u53BB\uFF01"
      speakerPortrait: {fileID: -604196761, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: edaa254e539355d4ca47829009c7a94c, type: 3}
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u5927\u50BB\u5E3D\uFF01\u4F5C\u4E3A\u5DE5\u5934\u7684\u6211\u653E\u4E0B\u5DE5\u5730\u4E0D\u7BA1\u90A3\u53EF\u600E\u4E48\u884C\uFF1F\u6211\u8FD9\u5C31\u628A\u4F60\u8D76\u51FA\u53BB\uFF01"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 7bd3bd812daad1e4b9b0fb77712d689c, type: 3}
  - playerName: Gutsman
    playerKey: Gutsman
    dialogueLines:
    - speakerName: "\u6C14\u529B\u4EBA\uFF1F"
      text: "\u54DF\uFF0C\u539F\u578B\uFF01\u641E\u573A\u529B\u91CF\u5BF9\u51B3\u548B\u6837\uFF1F\u6BD5\u7ADF\u4F60\u9664\u4E86\u529B\u91CF\u5565\u4E5F\u6CA1\u6709\u4E86\u5427\uFF1F"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 1fc2cbca5f19c244e9b2f6a9c19ed08a, type: 3}
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u4F60\u4E2B\uFF0C\u8FD9\u624B\u81C2\uFF0C\u8FD9\u817F\uFF0C\u8FD9\u8EAB\u4F53...\u4E0D\u662F\u5F88\u68D2\u561B\uFF01\uFF01\u8981\u662F\u6211\u8D62\u4E86\uFF0C\u6765\u6211\u5DE5\u5730\u5E2E\u5FD9\u5E72\u6D3B\u5427\uFF01"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 935ac7f4fb1a13e49a6160e22663cbc7, type: 3}
    - speakerName: "\u6C14\u529B\u4EBA\uFF1F"
      text: "\u6B38\uFF1F\u7B49...\u7B49\u4E00\u4E0B..."
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 0b81539791815aa4ab1791f5c837858a, type: 3}
  - playerName: Iceman
    playerKey: Iceman
    dialogueLines:
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u641E\u5565\u5B50\u561B\uFF0C\u600E\u4E48\u5C0F\u9B3C\u4F1A\u51FA\u73B0\u5728\u8FD9\u79CD\u5730\u65B9\u3002\u8FD9\u91CC\u662F\u5C5E\u4E8E\u7537\u5B50\u6C49\u7684\u5DE5\u5730\u55F7\uFF01\u4E0D\u60F3\u53D7\u4F24\u7684\u8BDD\u5C31\u8D76\u5FEB\u6EDA\u51FA\u53BB\uFF01"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: d14d5b5d2f9c36446abc3351bdf3c4b1, type: 3}
    - speakerName: "\u51B0\u96EA\u4EBA"
      text: "\u867D\u7136\u5F88\u4E0D\u597D\u610F\u601D\u8BF4\u51FA\u53E3...\u4F46\u662F\u8FD8\u8BF7\u60A8\u505C\u4E0B\u8FD9\u4EFD\u5DE5\u4F5C\u624D\u597D..."
      speakerPortrait: {fileID: -1915603046, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 10b5dba91e15ef44eb530cd25a475132, type: 3}
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u5927\u50BB\u5E3D\uFF01\u4F5C\u4E3A\u5DE5\u5934\u7684\u6211\u653E\u4E0B\u5DE5\u5730\u4E0D\u7BA1\u90A3\u53EF\u600E\u4E48\u884C\uFF1F\u6211\u8FD9\u5C31\u628A\u4F60\u8D76\u51FA\u53BB\uFF01"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 7bd3bd812daad1e4b9b0fb77712d689c, type: 3}
  - playerName: Bombman
    playerKey: Bombman
    dialogueLines:
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u641E\u5565\uFF0C\u70B8\u5F39\u4EBA...\u53EF\u6CA1\u8BA9\u4F60\u5728\u8FD9\u5757\u513F\u5730\u7206\u7834\u55F7\uFF01"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 7a70a1c8683aabc40862d919ddb67c9c, type: 3}
    - speakerName: "\u70B8\u5F39\u4EBA"
      text: "\u4F60\u8FD9\u5DE5\u5934\u771F\u4E0D\u591F\u610F\u601D\u554A...\u8001\u5B50\u6253\u67B6\u4E5F\u597D\u653E\u70DF\u82B1\u4E5F\u597D\uFF0C\u53EF\u90FD\u662F\u62FC\u4E86\u547D\u7684\uFF01"
      speakerPortrait: {fileID: 817042007, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: e768b11fe6576be4fbfd921bb7129604, type: 3}
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u60F3\u8DDF\u6211\u8FD9\u4E2A\u5DE5\u5934\u5E72\u4E00\u67B6\uFF1F\u6765\u554A\uFF01\u628A\u4F60\u7ED9\u6253\u6241\uFF01"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 3eb2abdf25dab2f4aae3de74b5c4be39, type: 3}
  - playerName: Fireman
    playerKey: Fireman
    dialogueLines:
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u5728\u6211\u5DE5\u5730\u6363\u4E71\u7684\u662F\u54EA\u4E2A\u5BB6\u4F19\uFF01\uFF1F"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 596bd509469a85241b3aabdd1af48ed9, type: 3}
    - speakerName: "\u706B\u7130\u4EBA"
      text: "\u90AA\u6076\u554A\uFF0C\u542C\u597D\u4E86\uFF01\u6211\u4E43\u706B\u7130\u4EBA\uFF01\u4EE5\u6B63\u4E49\u4E4B\u708E\u71C3\u5C3D\u7F6A\u6076\uFF01"
      speakerPortrait: {fileID: 104266460, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: ad9a56bf4fc1f9a4f96378b35505cfff, type: 3}
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u6211\u53EF\u4E0D\u662F\u90AA\u6076\uFF01\u662F\u5DE5\u5934\u55F7\uFF01\uFF01"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: c46eb7d6b9f642243a3eac8721699767, type: 3}
  - playerName: Elecman
    playerKey: Elecman
    dialogueLines:
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u5728\u6211\u5DE5\u5730\u6363\u4E71\u7684\u662F\u54EA\u4E2A\u5BB6\u4F19\uFF01\uFF1F"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 596bd509469a85241b3aabdd1af48ed9, type: 3}
    - speakerName: "\u7535\u529B\u4EBA"
      text: "\u2026\u5C31\u7B97\u4F60\u5288\u4E0B\u96F7\u9E23\u822C\u7684\u543C\u58F0\uFF0C\u4E5F\u65E0\u6CD5\u52A8\u6447\u6211\u7684\u5FC3\u2026"
      speakerPortrait: {fileID: -191070861, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 8cc59b0c66b935743a224457353247ab, type: 3}
    - speakerName: "\u6C14\u529B\u4EBA"
      text: "\u54FC\uFF01\u7B49\u77F3\u5934\u7838\u5230\u4F60\u5934\u4E0A\uFF0C\u770B\u4F60\u8FD8\u8BF4\u4E0D\u8BF4\u5F97\u51FA\u540C\u6837\u7684\u8BDD\u5427\uFF01"
      speakerPortrait: {fileID: -2147316367, guid: af628b0cfaeab414e9094a5e9e0dcb6d, type: 3}
      voiceClip: {fileID: 8300000, guid: 53acbeb95b70fce4892ed15d39fa74f1, type: 3}
  fillHealthSfx: {fileID: 8300000, guid: ca146d40119cf9443966cf3a809e6558, type: 3}
